---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getCollection('posts');
  // 生产构建里过滤掉草稿；本地 dev 全部显示，方便预览
  const visible = all.filter((p) => import.meta.env.PROD ? p.data.draft !== true : true);
  visible.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(visible, { pageSize: 6 });
}) satisfies GetStaticPaths;

interface Props { page: Page<CollectionEntry<'posts'>> }
const { page } = Astro.props;

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Layout title="文章 — Senko" active="posts">
  <h2 class="section-h"><span class="tilde">～</span><span>文章</span></h2>
  <p class="lede">在这里重新写一份正典版本。小红书是分发渠道，网站才是内容的家。</p>

  {page.data.length === 0 && (
    <p class="empty">还没有已发布的文章。</p>
  )}

  <ul class="post-list">
    {page.data.map((post) => (
      <li class="post-item">
        {post.data.draft && <span class="draft-badge">草稿</span>}
        <a class="post-link" href={`/posts/${post.slug}`}>
          <h3>{post.data.title}</h3>
        </a>
        <div class="meta">
          <time>{fmt(post.data.date)}</time>
          {post.data.source && <span class="dot">·</span>}
          {post.data.source && <span>{post.data.source}</span>}
        </div>
        {post.data.summary && <p class="summary">{post.data.summary}</p>}
        {post.data.tags.length > 0 && (
          <div class="tags">{post.data.tags.map((t) => <span>{t}</span>)}</div>
        )}
      </li>
    ))}
  </ul>

  {page.lastPage > 1 && (
    <nav class="pager" aria-label="分页">
      {page.url.prev
        ? <a href={page.url.prev} rel="prev">← 上一页</a>
        : <span class="disabled">← 上一页</span>}
      <span class="pageinfo">第 {page.currentPage} / {page.lastPage} 页</span>
      {page.url.next
        ? <a href={page.url.next} rel="next">下一页 →</a>
        : <span class="disabled">下一页 →</span>}
    </nav>
  )}
</Layout>

<style>
  .lede { color: var(--muted); font-weight: 300; margin-bottom: 12px; }
  .empty { color: var(--muted); padding: 24px 0; }

  .post-list { list-style: none; }
  .post-item { padding: 28px 0; }
  .post-item + .post-item { border-top: 1px solid var(--line); }

  .draft-badge {
    display: inline-block;
    font-size: 11px;
    color: var(--current);
    border: 1px solid var(--current);
    padding: 0 7px;
    margin-bottom: 10px;
    letter-spacing: 0.08em;
  }
  .post-link { text-decoration: none; display: inline-block; }
  .post-link h3 {
    font-size: 1.15rem;
    font-weight: 700;
    transition: color 0.2s;
  }
  .post-link:hover h3 { color: var(--current); }

  .meta {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .meta .dot { color: var(--line); }

  .summary { margin-top: 10px; color: var(--muted); font-weight: 300; }

  .tags { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .tags span {
    font-size: 12px;
    color: var(--current);
    letter-spacing: 0.06em;
  }
  .tags span::before { content: '#'; opacity: 0.5; }

  .pager {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
  }
  .pager a { text-decoration: none; color: var(--current); }
  .pager a:hover { text-decoration: underline; }
  .pager .disabled { color: var(--line); }
  .pager .pageinfo { color: var(--muted); font-size: 13px; }
</style>
